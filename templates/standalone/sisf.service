# systemd user unit for a Standalone SISF install.
#
# Copy it to ~/.config/systemd/user/{{ .Label }}.service and run
#   systemctl --user daemon-reload && systemctl --user enable --now {{ .Label }}
# `sisf up` runs in the foreground and supervises every process of the
# install, so systemd only has to keep this one command alive. Every start
# builds the factory from the source checkout with Go, so the unit starts in
# that checkout and its PATH holds the programs found when it was written.
[Unit]
Description=SISF factory {{ .FactoryID }} (Standalone)
After=network-online.target

[Service]
Type=simple
WorkingDirectory={{ .Source }}
Environment="PATH={{ .Path }}"
ExecStart="{{ .Sisf }}" up --mode standalone --dir "{{ .Dir }}" --source "{{ .Source }}"
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# The install directory holds the secrets; nobody else may read them.
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
